{
    "name": "anya-bot",
    "description": "Some random TypeScript bot with interesting features",
    "version": "3.0.0",
    "type": "module",
    "private": true,
    "module": "src/main.ts",
    "author": "SecondThundeR",
    "license": "MIT",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=24.19.0"
    },
    "imports": {
        "#root/*.js": "./src/*.ts",
        "#root/*": "./src/*.ts",
        "#drizzle/*.js": "./drizzle/*.ts",
        "#drizzle/*": "./drizzle/*.ts"
    },
    "scripts": {
        "dev": "NODE_ENV=development node --watch ./src/main.ts",
        "build": "tsdown",
        "start": "NODE_ENV=production node ./dist/main.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node ./drizzle/migrate.ts",
        "test": "node --test",
        "typecheck": "tsc",
        "lint": "biome check",
        "lint:write": "biome check --write",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@grammyjs/auto-chat-action": "0.1.1",
        "@grammyjs/commands": "1.4.0",
        "@grammyjs/hydrate": "1.7.0",
        "@grammyjs/i18n": "1.1.2",
        "@grammyjs/parse-mode": "1.11.1",
        "@grammyjs/runner": "2.0.3",
        "@hono/node-server": "2.1.1",
        "drizzle-orm": "0.45.3",
        "grammy": "1.46.0",
        "hono": "4.13.9",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3",
        "postgres": "3.4.9",
        "valibot": "1.5.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/node": "26.6.2",
        "drizzle-kit": "0.31.11",
        "tsdown": "0.23.0",
        "typescript": "7.0.2"
    }
}
